APP_NAME=Okyema

# On the VPS: APP_ENV=production, APP_DEBUG=false and APP_URL set to the public
# https URL. A leftover APP_URL=http://localhost:8000 breaks Google sign-in
# (the callback sent to Google is built from APP_URL) and any absolute URL.
#
#   Production: APP_URL=https://john.okyema.work
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single

# Local dev defaults to SQLite (database/database.sqlite). On the VPS use MySQL
# (the shared Compose stack runs an okyema-mysql service):
# DB_CONNECTION=mysql
# DB_HOST=okyema-mysql
# DB_PORT=3306
# DB_DATABASE=okyema
# DB_USERNAME=root
# DB_PASSWORD=
DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=database

# The SPA talks to /api with the session cookie, so every host you serve the
# app on must be listed — otherwise signing in succeeds and the next API call
# 401s, which looks like "Google sign-in failed".
#
# On the VPS add the public domain(s):
#   SANCTUM_STATEFUL_DOMAINS=john.okyema.work
#
# Locally, list every host:port you serve the app on — the SPA talks to /api
# with the session cookie, so a port that is missing here 401s and bounces
# you back to /login.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,localhost:8080,127.0.0.1,127.0.0.1:8000,127.0.0.1:8080

# Google OAuth (optional)
#
# The redirect URI must be registered in the Google Cloud console character for
# character. Local dev: leave GOOGLE_REDIRECT_URI empty so the app follows
# whatever host you are browsing. Production: SET IT.
#   GOOGLE_REDIRECT_URI=https://john.okyema.work/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Microsoft OAuth (optional, Milestone 1+)
#   MICROSOFT_REDIRECT_URI=https://john.okyema.work/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=

# Deployment notifications
DEPLOY_EMAIL=

# Mail (for deploy notifications)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@regno.ai
MAIL_FROM_NAME="Okyema"

# Regno AI (optional — deterministic fallback used when disabled)
AI_ENABLED=false
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=

# Receipt capture (Milestone 3)
RECEIPT_SCAN_ENABLED=true
RECEIPT_SCAN_MAX_KB=8192
