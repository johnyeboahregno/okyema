APP_NAME=Okyema

# On the VPS: APP_ENV=production, APP_DEBUG=false and APP_URL set to the public
# https URL. A leftover APP_URL=http://localhost:8000 breaks Google sign-in
# (the callback sent to Google is built from APP_URL) and any absolute URL.
#
#   Production: APP_URL=https://john.okyema.work
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_STACK=single

# Local dev defaults to SQLite (database/database.sqlite). On the VPS use MySQL
# (the shared Compose stack runs an okyema-mysql service):
# DB_CONNECTION=mysql
# DB_HOST=okyema-mysql
# DB_PORT=3306
# DB_DATABASE=okyema
# DB_USERNAME=root
# DB_PASSWORD=
DB_CONNECTION=sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120

CACHE_STORE=file
QUEUE_CONNECTION=database

# The SPA talks to /api with the session cookie, so every host you serve the
# app on must be listed — otherwise signing in succeeds and the next API call
# 401s, which looks like "Google sign-in failed".
#
# On the VPS add the public domain(s):
#   SANCTUM_STATEFUL_DOMAINS=john.okyema.work
#
# Locally, list every host:port you serve the app on — the SPA talks to /api
# with the session cookie, so a port that is missing here 401s and bounces
# you back to /login.
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:8000,localhost:8080,127.0.0.1,127.0.0.1:8000,127.0.0.1:8080

# Google OAuth (optional)
#
# The redirect URI must be registered in the Google Cloud console character for
# character. Local dev: leave GOOGLE_REDIRECT_URI empty so the app follows
# whatever host you are browsing. Production: SET IT.
#   GOOGLE_REDIRECT_URI=https://john.okyema.work/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# Microsoft OAuth (optional, Milestone 1+)
#   MICROSOFT_REDIRECT_URI=https://john.okyema.work/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_REDIRECT_URI=

# Calendar connectors (Settings → Connections). These are separate OAuth
# clients from the sign-in flow above — do not reuse those credentials.
# Redirect URI path is /connectors/{provider}/callback; leave the *_URI empty
# locally and the app derives it from the host you browse.
#   GOOGLE_CALENDAR_REDIRECT_URI=https://john.okyema.work/connectors/google/callback
#   MICROSOFT_CALENDAR_REDIRECT_URI=https://john.okyema.work/connectors/microsoft/callback
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
MICROSOFT_CALENDAR_CLIENT_ID=
MICROSOFT_CALENDAR_CLIENT_SECRET=
MICROSOFT_CALENDAR_REDIRECT_URI=

# Deployment notifications
DEPLOY_EMAIL=

# Mail (for deploy notifications)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@regno.ai
MAIL_FROM_NAME="Okyema"

# Regno AI (optional — deterministic fallback used when disabled)
AI_ENABLED=false
AI_PROVIDER=deepseek
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.deepseek.com
AI_TIMEOUT_SECONDS=30
AI_MAX_TOKENS=2000
AI_TEMPERATURE=0.2

# Vision (receipt scanning). DeepSeek has no image support, so point these at
# a vision-capable endpoint (e.g. OpenAI). Empty values fall back to the chat
# provider above.
AI_VISION_ENABLED=
AI_VISION_MODEL=
AI_VISION_API_KEY=
AI_VISION_BASE_URL=

# Meeting transcription. The recorder transcribes on-device in the browser
# (Whisper via transformers.js) — no key needed. Set these only if you switch
# to AssemblyAI server-side transcription instead.
TRANSCRIPTION_PROVIDER=assemblyai
ASSEMBLYAI_API_KEY=
ASSEMBLYAI_WEBHOOK_SECRET=

# Shared ai-client package location (dev machines without Composer install)
#   SHARED_AI_CLIENT_PATH=../ai-client/src
# CA bundle for outbound HTTPS (Windows PHP ships without one)
#   CA_BUNDLE_PATH=

# Receipt capture (Milestone 3)
RECEIPT_SCAN_ENABLED=true
RECEIPT_SCAN_MAX_KB=8192

# Currency
OKYEMA_CURRENCY=GBP
OKYEMA_CURRENCY_SYMBOL=£

# ── Interface mode ─────────────────────────────────────────────
# Which shell the dashboard renders for the whole deployment:
#   classic = the full workspace SPA (default)
#   simple  = the focused assistant screen
# Read at runtime by the PHP shell (no build step). Invalid values fall back
# to classic and are reported in the application log.
OKYEMA_UI_MODE=classic

# ── Notion (optional) ──────────────────────────────────────────
# Public integration OAuth credentials (Settings → Connections → Notion).
# Redirect URI path is /connectors/notion/callback.
#   NOTION_REDIRECT_URI=https://john.okyema.work/connectors/notion/callback
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=
NOTION_VERSION=2022-06-28

# One Notion database id per workspace context (for the assistant's Notion
# search and approval-gated page writes). Leave empty to disable Notion for
# that context.
NOTION_DATABASE_REGNO=
NOTION_DATABASE_LAUNCHPAD=
NOTION_DATABASE_PERSONAL=
